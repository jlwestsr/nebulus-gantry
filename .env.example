# Database
DATABASE_URL=sqlite:///./data/gantry.db

# Authentication
SECRET_KEY=change-me-in-production
SESSION_EXPIRE_HOURS=24

# ChromaDB (vector memory)
NEBULUS_CHROMA_URL=http://chromadb:8000  # was CHROMA_HOST

# LLM inference (OpenAI-compatible endpoint)
NEBULUS_LLM_URL=http://tabby:5000  # was TABBY_HOST

# Frontend (used in docker-compose for Vite)
VITE_API_URL=http://localhost:8000

# Docker network (override for non-Prime deployments)
# NEBULUS_NETWORK=nebulus-prime_ai-network
